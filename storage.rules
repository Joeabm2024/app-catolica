rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Storage Rules v2 puede consultar Firestore directamente para
    // verificar el rol del usuario (mismo patrón que isAdmin() en
    // firestore.rules, pero con la sintaxis propia de Storage).
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    match /avatars/{uid}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024 // máx 5MB
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /cantos_pdf/{cantoId}.pdf {
      allow read: if request.auth != null;
      allow write: if isAdmin()
                   && request.resource.size < 15 * 1024 * 1024 // máx 15MB
                   && request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }

    // Bloqueo por defecto para cualquier otra ruta.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
